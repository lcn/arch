UUID=59027b5c-90aa-415c-9ca9-d572cd283b5c /var/cache     btrfs   subvol=/@cache,defaults,noatime,compress=zstd,commit=120 0 0
UUID=59027b5c-90aa-415c-9ca9-d572cd283b5c /var/tmp       btrfs   subvol=/@tmp,defaults,noatime,compress=zstd,commit=120 0 0
UUID=59027b5c-90aa-415c-9ca9-d572cd283b5c /var/log       btrfs   subvol=/@log,defaults,noatime,compress=zstd,commit=120 0 0
